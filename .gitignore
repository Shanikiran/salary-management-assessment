target/
node_modules/
dist/
# Angular production build copied in for the jar (regenerated by scripts/build-frontend.sh)
backend/src/main/resources/static/
*.log
*.db
# Exception: the SEEDED demo DB is tracked on purpose — Render's Docker
# build needs it in the repo (Dockerfile COPYs it into the runtime image).
# Without this line the Render build fails: the file is absent from the
# GitHub checkout and `COPY backend/data/salary.db` errors out. Re-seed
# locally with `bash scripts/seed.sh --reset`, then commit the new DB.
!backend/data/salary.db
*.db-journal
.DS_Store
.angular/
*.class
